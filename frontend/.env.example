VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Backend API base (proxied by Vite in dev, nginx in prod)
BRIDGE_API_URL=http://localhost:8000
BRIDGE_WS_URL=ws://localhost:8000

# CRM/Outreach API — point at same backend process (port 8000)
BRIDGE_CRM_URL=http://localhost:8000

# Outreach email provider (optional — leave blank to queue only, no sending)
OUTREACH_EMAIL_PROVIDER=
OUTREACH_FROM_EMAIL=no-reply@ai-os.co.za
SENDGRID_API_KEY=
RESEND_API_KEY=
