# Logpush to R2 Configuration
# Enable Worker + HTTP request logging to R2 bucket

[[logs]]
name = "bridge-edge-logs"
enabled = true
destination = "r2"
bucket = "bridge-logs"
region = "auto"

# Log fields
[logs.fields]
default = true

[logs.fields.request]
include = [
  "Timestamp",
  "EventType",
  "EventName",
  "SrcIP",
  "EdgeResponseStatus",
  "EdgeResponseBytes",
  "RayID",
  "RequestMethod",
  "RequestURI",
  "RequestScheme",
  "RequestHost",
  "UserAgent",
]

[logs.fields.custom]
include = [
  "X-Request-ID",
  "X-User-ID",
  "X-User-Role",
]

# Filter: Only log errors and auth events
[logs.filter]
or = [
  { EventName = "error" },
  { EdgeResponseStatus >= 400 },
  { EdgeResponseStatus < 200 },
]

# Retention
retention_days = 30
