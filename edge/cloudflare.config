# Cloudflare Zone Configuration
# Bridge AI OS - Sovereign Infrastructure

# PRIMARY ZONES (need to be purchased/pointed)
[zones]
primary = "bridge-ai-os.com"

# All mapped domains (same zone)
[[zones.domains]]
name = "bridge-ai-os.com"
type = "full"
priority = 1

[[zones.domains]]
name = "www.bridge-ai-os.com"
type = "full"

[[zones.domains]]
name = "bridge-ai-os.co.za"
type = "full"

[[zones.domains]]
name = "bridge-ai-os.org"
type = "full"

[[zones.domains]]
name = "bridge-ai-os.tech"
type = "full"

[[zones.domains]]
name = "bridge-ai-os.xyz"
type = "full"

# COMMAND LAYER
[[zones.domains]]
name = "supaco.io"
type = "full"

[[zones.domains]]
name = "www.supaco.io"
type = "full"

[[zones.domains]]
name = "supaco.ai"
type = "full"

[[zones.domains]]
name = "supaco.co.za"
type = "full"

[[zones.domains]]
name = "supaco.team"
type = "full"

[[zones.domains]]
name = "supaco.tech"
type = "full"

[[zones.domains]]
name = "supaco.xyz"
type = "full"

# TREASURY / INTERNAL
[[zones.domains]]
name = "ai-os.co.za"
type = "full"
access = "zero-trust"

# SECURITY
[security]
ssl = "strict"
hsts = true
always_use_https = true
minimum_tls_version = "1.3"
tls_1_3 = true

# RATE LIMITING
[[rate_limits]]
id = "api-rate-limit"
uri = "/api/*"
requests = 100
window = 60
action = "block"

[[rate_limits]]
id = "auth-rate-limit"
uri = "/api/auth/*"
requests = 10
window = 60
action = "block"

# BOT MANAGEMENT
[security.bot_management]
enabled = true
fight_bots = true
