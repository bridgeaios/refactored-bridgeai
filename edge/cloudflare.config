# Cloudflare Zone Configuration
# Target: supaco.io (primary) or bridge-ai-os.com

[[domains]]
name = "supaco.io"
type = "full"
plan = "free"

[[domains]]
name = "www.supaco.io"
type = "full"
plan = "free"

# Production zones to add
# bridge-ai-os.com
# www.bridge-ai-os.com
# ai-os.co.za

[security]
ssl = "strict"
hsts = true
always_use_https = true
minimum_tls_version = "1.3"

[security.trailing_slash]
redirect = true

[rules]
# Block common attacks
[security.bot_management]
enabled = true

[observability]
logpush = true
log retention = 30

# Rate limiting
[[rate_limits]]
id = "api-rate-limit"
uri = "/api/*"
requests = 100
window = 60
action = "challenge"

# Custom error page
[pages]
custom_error_page = "/error"
