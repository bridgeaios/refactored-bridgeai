# BridgeAI Backend — environment variables
# Copy to .env and fill in values

# ── Database ───────────────────────────────────────────────────────────────
# Dev: leave blank → sqlite+aiosqlite:///.bridge-state/defi.db
# Prod: set to Neon PostgreSQL URL
DATABASE_DEFI_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/bridge

# ── SIWE / JWT Auth ────────────────────────────────────────────────────────
BRIDGE_SIWE_JWT_SECRET=change-me-generate-with-python-secrets-token-hex-64
BRIDGE_SIWE_JWT_EXPIRY=86400

# ── CRM / Lead Gen pipeline ────────────────────────────────────────────────
# Same process as backend — workers.py posts here
BRIDGE_CRM_URL=http://localhost:8000
# Output directory for scraper artefacts
BRIDGE_OUTPUT_ROOT=./output
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3020,https://go.ai-os.co.za

# ── Outreach ───────────────────────────────────────────────────────────────
OUTREACH_EMAIL_PROVIDER=
OUTREACH_FROM_EMAIL=no-reply@ai-os.co.za
SENDGRID_API_KEY=
RESEND_API_KEY=

# ── Payments ───────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxx
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── Treasury ───────────────────────────────────────────────────────────────
# Controls write access to /api/treasury/disburse
# Modes: env_local | allow_flag | token | (blank = disabled)
BRIDGE_ALLOW_TREASURY_WRITES=
CFO_TOKEN=change-me-strong-token

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── KeyForge ───────────────────────────────────────────────────────────────
KEYFORGE_MASTER_SECRET=change-me-generate-with-python-secrets-token-hex-64

# ── Environment ────────────────────────────────────────────────────────────
ENV=production
