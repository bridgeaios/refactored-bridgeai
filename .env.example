# Bridge AI OS Environment Variables
# Copy this file to .env and fill in your values.
# Or set in E:\AOE\.env. See KEYS-REQUIRED.md for full list. Never commit .env with real secrets.

# --- Critical (6) ---
OPENAI_API_KEY=
HF_TOKEN=
HUGGING_FACE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
JWT_SECRET=
JWT_SECRET_KEY=

# --- Optional (6) ---
TURNSTILE_SECRET_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
SMTP_PASSWORD=
PAYPAL_CLIENT_ID=
DISCORD_BOT_TOKEN=

# --- Cloudflare R2 (optional) ---
R2_BUCKET_NAME=

# --- Bridge (optional) ---
