# BridgeAI Environment Configuration Template
# Copy this file to .env and fill in all required values
# IMPORTANT: Never commit .env with real credentials to version control

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@hostname:port/database_name
# Example: postgresql://bridgeai:YourSecurePassword123@db.example.com:5432/bridgeai
# For local development: postgresql://bridgeai:password@localhost:5432/bridgeai
#
# SECURITY NOTE: Use strong passwords (16+ characters with mixed case, numbers, symbols)
DATABASE_URL=postgresql://bridgeai:CHANGE_ME_STRONG_PASSWORD@localhost:5432/bridgeai

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================

# Redis connection string with optional password
# Without password: redis://localhost:6379
# With password: redis://:password@localhost:6379
# With custom host: redis://:password@redis.example.com:6379
#
# SECURITY NOTE: Redis without password auth is vulnerable to unauthorized access.
# Always configure requirepass in /etc/redis/redis.conf for production.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379

# ============================================================================
# CLERK AUTHENTICATION
# ============================================================================

# Clerk Secret Key (must be kept private - never expose to frontend/client)
# Get from: https://dashboard.clerk.com → Developers → API Keys
# Format: sk_test_... or sk_live_...
#
# SECURITY NOTE: This key grants access to all Clerk operations including user deletion.
# Store securely and rotate regularly in production.
CLERK_SECRET_KEY=sk_test_CHANGE_ME_CLERK_SECRET_KEY

# Clerk Publishable Key (safe to expose - used in frontend)
# Get from: https://dashboard.clerk.com → Developers → API Keys
# Format: pk_test_... or pk_live_...
#
# This key is used by the frontend for Clerk authentication UI and is safe to expose.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME_CLERK_PUBLIC_KEY

# ============================================================================
# VERCEL AI GATEWAY (Optional - only if using AI features)
# ============================================================================

# Vercel OIDC Token for AI Gateway authentication
# Get from: https://vercel.com → Settings → Tokens
# Used for: Vercel AI Gateway API access (Claude, GPT, etc.)
#
# OPTIONAL: Leave empty if not using Vercel AI Gateway
VERCEL_OIDC_TOKEN=

# ============================================================================
# CSRF SECURITY
# ============================================================================

# CSRF Secret Key for token generation
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# A unique, random 32-byte value in URL-safe base64 encoding
#
# SECURITY NOTE: Change this value periodically in production.
# Changing it will invalidate all existing CSRF tokens.
CSRF_SECRET_KEY=CHANGE_ME_CSRF_SECRET

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Server host address
# 0.0.0.0 = listen on all interfaces (good for Docker/VPS)
# 127.0.0.1 = localhost only (requires reverse proxy for external access)
API_HOST=0.0.0.0

# Server port number
# Default: 8000
# Adjust if port is already in use or behind a reverse proxy
API_PORT=8000

# Debug mode (production must be false)
# true = detailed error messages, slower performance
# false = minimal error info, optimized performance
#
# SECURITY NOTE: Never set DEBUG=true in production
DEBUG=false

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Logging level
# Options: debug, info, warning, error, critical
# Use 'debug' for development, 'info' for production
LOG_LEVEL=info
