# Bridge AI OS Environment Variables
# Copy this file to .env and fill in your values.
# Or set in E:\AOE\.env. See KEYS-REQUIRED.md for full list. Never commit .env with real secrets.

# --- Critical (6) ---
OPENAI_API_KEY=
HF_TOKEN=
HUGGING_FACE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
JWT_SECRET=
JWT_SECRET_KEY=

# --- Optional (6) ---
TURNSTILE_SECRET_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
SMTP_PASSWORD=
PAYPAL_CLIENT_ID=
DISCORD_BOT_TOKEN=

# --- Cloudflare R2 (optional) ---
R2_BUCKET_NAME=

# --- Bridge ---
# BRIDGE_OS_USER=supa
BRIDGE_SIWE_JWT_SECRET=change-me-in-production
BRIDGE_LIVE_WALL_PATH=E:\BridgeAI\BridgeLiveWall

# --- Infrastructure (replaces hardcoded values in docker-compose.yml) ---
NEO4J_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- Determinator RBAC (required — login is rejected until these are set) ---
DETERMINATOR_USER=
DETERMINATOR_PASS=

# --- Payments ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Comms ---
RESEND_API_KEY=

# --- Google Sheets API ---
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_CREDENTIALS_JSON=

# --- YouTube Data API v3 ---
# Get from Google Cloud Console → APIs & Services → YouTube Data API v3
# Free quota: 10,000 units/day (~100 searches). Search costs 100 units; video fetch costs 1.
YOUTUBE_API_KEY=

# --- Services ---
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
